# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (OpenRouter)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# STT (Speech-to-Text)
# Локально: faster-whisper (модель small качается при первом старте).
# В проде (Heroku, 512 МБ RAM) — облако: STT_PROVIDER=openai.
STT_PROVIDER=faster-whisper
# Модель: faster-whisper — small/base/medium; облако OpenAI — whisper-1,
# Groq — whisper-large-v3-turbo. Пусто = авто-выбор по провайдеру.
STT_MODEL=small
# OpenAI-совместимая база облачного STT:
#   OpenAI — https://api.openai.com/v1, Groq — https://api.groq.com/openai/v1
STT_BASE_URL=https://api.openai.com/v1
# Ключ облачного STT. Пусто -> используется LLM_API_KEY.
STT_API_KEY=
# Таймаут одного запроса распознавания (секунды).
STT_TIMEOUT_SEC=60
# Язык распознавания (en — английский).
STT_LANGUAGE=en
# Не больше N распознаваний в минуту на пользователя (0 = без лимита).
STT_MAX_PER_MIN=10

# TTS (Text-to-Speech)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-JennyNeural
TTS_API_KEY=                               # нужен только при TTS_PROVIDER=openai

# База данных
DATABASE_PATH=/data/english_bot.db
# PostgreSQL (Heroku): DATABASE_URL выдаётся аддоном heroku-postgresql (DATABASE_URL).
# Заполнено -> хранилище на asyncpg вместо SQLite. Пустое -> локальный SQLite.
DATABASE_URL=

# Режим деплоя (Heroku): 1 = webhook на $PORT, 0 (пусто/не задан) = локальный polling.
USE_WEBHOOK=0
# Секретный путь webhook. Пустое = генерируется случайно при каждом старте.
# ВНИМАНИЕ: если задать вручную — нельзя менять после публикации (Telegram кэширует URL),
# лучше оставить пустым и не выкладывать в репозиторий.
WEBHOOK_PATH=
# Публичный HTTPS-корень в проде (для webhook и Mini App). Пустое = используется WEBAPP_URL.
WEBAPP_PUBLIC_URL=
# Порт webhook-сервера. На Heroku задаётся платформой автоматически ($PORT).
PORT=

# Кэш Hugging Face (для whisper)
HF_HOME=/data/hf_cache

# Тюнинг
MAX_CONTEXT_MESSAGES=6
MAX_VOICE_DURATION_SEC=60
# Жёсткий лимит размера аудиофайла для распознавания (байт, 8 МБ).
MAX_AUDIO_BYTES=8388608

# Дневной лимит LLM-действий на пользователя (0 = без лимита; для тестирования ~30)
LLM_DAILY_LIMIT=30

# Промокод на безлимит. Пользователь шлёт боту /promo <код> — лимит снимается навсегда.
# Пустое значение = промокоды выключены.
PROMO_UNLIMITED_CODE=

# ==== ЗАЩИТА API ОТ ПЕРЕГРУЗКИ (web) ====
# Сколько LLM-вызовов идут одновременно; остальные ждут в очереди.
LLM_MAX_CONCURRENCY=8
# Сколько запросов максимум ждут в очереди; остальные получат 429 сразу.
LLM_QUEUE_MAX=64
# Сколько секунд запрос может ждать слот, потом 429.
LLM_QUEUE_TIMEOUT_SEC=25
# Таймаут одного LLM-вызова (секунды): зависший запрос не держит слот.
LLM_TIMEOUT_SEC=90
# Параллельное распознавание речи (faster-whisper тяжёлый по CPU).
STT_MAX_CONCURRENCY=2
# Троттлинг LLM-действий на пользователя (чат и диагностика).
API_LLM_ACTIONS_PER_MIN=12
API_LLM_MIN_INTERVAL_SEC=2
# Общий лимит запросов на клиента (IP) в минуту (0 = выключить).
API_RATE_LIMIT_PER_MIN=240
API_RATE_LIMIT_WINDOW_SEC=60

# Подписки: оплата вручную через Kaspi QR (перевод с комментарием BOT-XXXX),
# подтверждение админом по скриншоту чека.
SUBSCRIPTION_PLANS=1:990,7:1990,30:1990   # дней:цена в тенге, через запятую
ADMIN_TG_ID=                               # твой Telegram ID — сюда прилетают чеки
KASPI_QR_PATH=/data/kaspi_qr.png           # путь к картинке со статичным Kaspi QR

# Telegram Mini App (интерактивный урок).
# WEBAPP_URL — ПУБЛИЧНЫЙ HTTPS-адрес (Telegram не открывает Mini App на localhost).
# Пример для этапа разработки: cloudflared quick tunnel на порт WEBAPP_PORT.
# Пустое значение = Mini App выключен, бот работает как раньше (уроки в чате).
WEBAPP_URL=
# Порт локального aiohttp-сервера Mini App (он же порт туннеля).
WEBAPP_PORT=8081
# Интерфейс локального сервера Mini App. 127.0.0.1 = только свой компьютер.
WEBAPP_HOST=127.0.0.1
# Отладка без Telegram: 1 = не проверять HMAC-подпись initData (НИКОГДА в проде).
WEBAPP_INSECURE_AUTH=0

# RAG-тьютор (/tutor): отвечает на вопросы по грамматике по корпусу правил.
# ДОПОЛНЯЕТ адаптивную практику, не заменяя её (RAG живёт в отдельном режиме).
# EMBED-модель должна поддерживаться вашим LLM_PROVIDER
# (OpenRouter поддерживает openai/text-embedding-3-small).
RAG_EMBED_MODEL=openai/text-embedding-3-small
# Порог похожести на правило (0–1): ниже — обычный ответ LLM по памяти.
RAG_THRESHOLD=0.30

# ——— Веб-продукт AdaptENG (api/ + frontend/) ———
# @username бота для кнопки Telegram Login Widget на лендинге (без @).
TG_WIDGET_BOT_USERNAME=
# Секрет JWT-сессий web. ОБЯЗАТЕЛЕН при запуске api (иначе упадёт при старте).
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=
# Срок жизни сессии в днях.
JWT_TTL_DAYS=30
# Разрешённые origins для CORS api через запятую. Пустое = localhost:3000 (дефолт для разработки).
# Пример прод: https://adapteng.app,https://www.adapteng.app
API_CORS_ORIGINS=
# 1 = не проверять HMAC-подпись Telegram Login Widget (только локальная отладка, НИКОГДА в проде).
API_INSECURE_AUTH=0
