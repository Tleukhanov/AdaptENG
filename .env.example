# Telegram
TELEGRAM_BOT_TOKEN=

# LLM (OpenRouter)
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# STT (Speech-to-Text)
STT_PROVIDER=faster-whisper
STT_MODEL=small

# TTS (Text-to-Speech)
TTS_PROVIDER=edge-tts
TTS_VOICE=en-US-JennyNeural
TTS_API_KEY=                               # нужен только при TTS_PROVIDER=openai

# База данных
DATABASE_PATH=/data/english_bot.db

# Кэш Hugging Face (для whisper)
HF_HOME=/data/hf_cache

# Тюнинг
MAX_CONTEXT_MESSAGES=6
MAX_VOICE_DURATION_SEC=60

# Дневной лимит LLM-действий на пользователя (0 = без лимита; для тестирования ~30)
LLM_DAILY_LIMIT=30

# Промокод на безлимит. Пользователь шлёт боту /promo <код> — лимит снимается навсегда.
# Пустое значение = промокоды выключены.
PROMO_UNLIMITED_CODE=

# Подписки: оплата вручную через Kaspi QR (перевод с комментарием BOT-XXXX),
# подтверждение админом по скриншоту чека.
SUBSCRIPTION_PLANS=1:990,7:1990,30:1990   # дней:цена в тенге, через запятую
ADMIN_TG_ID=                               # твой Telegram ID — сюда прилетают чеки
KASPI_QR_PATH=/data/kaspi_qr.png           # путь к картинке со статичным Kaspi QR

# Telegram Mini App (интерактивный урок).
# WEBAPP_URL — ПУБЛИЧНЫЙ HTTPS-адрес (Telegram не открывает Mini App на localhost).
# Пример для этапа разработки: cloudflared quick tunnel на порт WEBAPP_PORT.
# Пустое значение = Mini App выключен, бот работает как раньше (уроки в чате).
WEBAPP_URL=
# Порт локального aiohttp-сервера Mini App (он же порт туннеля).
WEBAPP_PORT=8081
# Интерфейс локального сервера Mini App. 127.0.0.1 = только свой компьютер.
WEBAPP_HOST=127.0.0.1
# Отладка без Telegram: 1 = не проверять HMAC-подпись initData (НИКОГДА в проде).
WEBAPP_INSECURE_AUTH=0

# RAG-тьютор (/tutor): отвечает на вопросы по грамматике по корпусу правил.
# ДОПОЛНЯЕТ адаптивную практику, не заменяя её (RAG живёт в отдельном режиме).
# EMBED-модель должна поддерживаться вашим LLM_PROVIDER
# (OpenRouter поддерживает openai/text-embedding-3-small).
RAG_EMBED_MODEL=openai/text-embedding-3-small
# Порог похожести на правило (0–1): ниже — обычный ответ LLM по памяти.
RAG_THRESHOLD=0.30
